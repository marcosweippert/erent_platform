<div class="bg-white rounded shadow p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Usuários</h1>
      <p class="text-sm text-gray-600 mt-1">Somente usuários master podem adicionar novos usuários.</p>
    </div>
    <%= link_to "Novo usuário", new_user_path, class: "btn btn-primary" %>
  </div>

  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50 text-left text-sm uppercase tracking-wider text-gray-500">
      <tr>
        <th class="px-4 py-3">Nome</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Master</th>
        <th class="px-4 py-3">Criado em</th>
        <th class="px-4 py-3">Ações</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3"><%= user.name %></td>
          <td class="px-4 py-3"><%= user.email %></td>
          <td class="px-4 py-3"><%= user.master? ? 'Sim' : 'Não' %></td>
          <td class="px-4 py-3"><%= l(user.created_at, format: :short) %></td>
          <td class="px-4 py-3">
            <%= link_to "Editar", edit_user_path(user), class: "btn btn-ghost btn-xs" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
