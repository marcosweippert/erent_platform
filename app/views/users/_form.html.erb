<div class="space-y-4">
  <div>
    <%= form.label :name, "Nome completo", class: "block font-semibold mb-1" %>
    <%= form.text_field :name, class: "w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= form.label :email, "Email", class: "block font-semibold mb-1" %>
    <%= form.email_field :email, class: "w-full rounded border px-3 py-2" %>
  </div>

  <% if form.object.persisted? %>
    <div>
      <%= form.label :password, "Nova senha (opcional)", class: "block font-semibold mb-1" %>
      <%= form.password_field :password, class: "w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirmação de nova senha", class: "block font-semibold mb-1" %>
      <%= form.password_field :password_confirmation, class: "w-full rounded border px-3 py-2" %>
    </div>
  <% end %>

  <div class="flex justify-end">
    <%= form.submit class: "btn btn-primary" %>
  </div>
</div>
