<div class="min-h-screen bg-slate-950 flex items-center justify-center py-12">
  <div class="w-full max-w-md bg-slate-900/95 border border-emerald-800 p-8 rounded-3xl shadow-2xl">
    <h1 class="text-3xl font-bold mb-6 text-center text-emerald-300">Recuperar acesso</h1>

    <div class="mb-4 rounded border border-emerald-200 bg-emerald-50 p-4 text-emerald-800 text-sm">
      <p>Digite seu email para receber a senha padrão e redefinir sua senha.</p>
    </div>

    <% if flash[:alert] %>
      <div class="mb-4 rounded border border-red-300 bg-red-50 p-4 text-red-700 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: forgot_password_path, scope: :forgot_password, local: true do |form| %>
      <div class="mb-6">
        <%= form.label :email, "Email", class: "block font-semibold mb-1 text-gray-700" %>
        <%= form.email_field :email, class: "w-full rounded border border-gray-300 px-3 py-2", autofocus: true %>
      </div>

      <%= form.submit "Enviar", class: "w-full btn btn-primary" %>
    <% end %>

    <div class="mt-6 text-sm text-center">
      <%= link_to "Voltar para login", new_session_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>
</div>
