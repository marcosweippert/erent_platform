<div class="container mx-auto px-4 py-6 space-y-8">
  <section class="rounded-[2rem] bg-white/90 dark:bg-slate-950/90 border border-slate-200 dark:border-slate-800 shadow-xl backdrop-blur-md p-8">
    <div class="flex flex-col gap-6 xl:gap-10 xl:flex-row xl:items-center xl:justify-between">
      <div class="space-y-4 max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-xs font-semibold dark:bg-emerald-900/40 dark:text-emerald-200">Dashboard moderno</span>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">eRent — Gestão inteligente de aluguel</h1>
        <p class="text-slate-600 dark:text-slate-300 text-lg leading-8">Monitore ocupação, contratos e reservas em um único lugar. Reserve imóveis disponíveis com fluxo claro e histórico preservado.</p>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-4">
    <%= render 'kpi_card', title: 'Pessoas', count: @people_count, icon: '👥', link: people_path, link_text: 'Acessar Pessoas' %>
    <%= render 'kpi_card', title: 'Imóveis', count: @properties_count, icon: '🏘️', link: properties_path, link_text: 'Acessar Imóveis' %>
    <%= render 'kpi_card', title: 'Contratos', count: @contracts_count, icon: '📄', link: contracts_path, link_text: 'Acessar Contratos' %>
    <%= render 'kpi_card', title: 'Aditivos', count: @amendments_count, icon: '📝', link: contract_amendments_path, link_text: 'Acessar Aditivos' %>
  </div>

  <section class="bg-white rounded-3xl shadow border border-slate-200 dark:bg-slate-950/95 dark:border-slate-800 p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Imóveis disponíveis</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Selecione um imóvel e registre uma reserva com início e fim.</p>
      </div>
      <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200"><%= @available_properties.count %> disponíveis</span>
    </div>

    <div class="mt-6 overflow-x-auto">
      <table class="min-w-full text-sm text-left text-slate-700 dark:text-slate-200">
        <thead class="bg-slate-50 dark:bg-slate-900">
          <tr>
            <th class="px-4 py-3">ID</th>
            <th class="px-4 py-3">Referência</th>
            <th class="px-4 py-3">Endereço</th>
            <th class="px-4 py-3">Proprietário</th>
            <th class="px-4 py-3">Valor</th>
            <th class="px-4 py-3">Ação</th>
          </tr>
        </thead>
        <tbody>
          <% @available_properties.each do |property| %>
            <tr class="border-t border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900">
              <td class="px-4 py-3"><%= property.id %></td>
              <td class="px-4 py-3"><%= property.reference %></td>
              <td class="px-4 py-3"><%= property.street %>, <%= property.number %> — <%= property.city %>/<%= property.state %></td>
              <td class="px-4 py-3"><%= property.owner.name %></td>
              <td class="px-4 py-3"><%= number_to_currency(property.rent_value, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
              <td class="px-4 py-3">
                <button type="button" data-reserve-open="reserve-modal" data-property-id="<%= property.id %>" data-property-address="<%= property.street %>, <%= property.number %> — <%= property.city %>/<%= property.state %>" data-rent-value="<%= property.rent_value %>" class="btn btn-accent">Reservar</button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @available_properties.none? %>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Nenhum imóvel disponível no momento.</p>
      <% end %>
    </div>
  </section>

  <section class="card">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Tendência de contratos</h2>
      <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200">Últimos 12 meses</span>
    </div>
    <div data-controller="dashboard" data-dashboard-labels='<%= @chart_labels.to_json %>' data-dashboard-values='<%= @chart_data.to_json %>' class="chart-container mt-4">
      <canvas id="dashboardChart" class="w-full h-full"></canvas>
    </div>
  </section>

  <div id="reserve-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 px-4 py-6">
    <div class="w-full max-w-2xl overflow-hidden rounded-3xl border border-emerald-800 bg-white p-6 shadow-2xl dark:bg-slate-900">
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">Reservar imóvel</h3>
          <p id="reserve_property_details" class="text-sm text-slate-500 dark:text-slate-400">Escolha um inquilino e defina as datas da reserva.</p>
        </div>
        <button type="button" data-reserve-close class="btn btn-ghost">Cancelar</button>
      </div>
      <%= form_with url: contracts_path, scope: :contract, local: true, class: 'mt-6 space-y-4' do |form| %>
        <%= form.hidden_field :property_id, id: 'reserve_property_id' %>
        <%= form.hidden_field :status, value: 'reserved' %>
        <%= form.hidden_field :signature_date, value: Date.current.strftime('%Y-%m-%d') %>
        <%= form.hidden_field :rent_value, id: 'reserve_rent_value' %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :tenant_id, 'Inquilino', class: 'block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1' %>
            <%= form.collection_select :tenant_id, @tenants, :id, :name, { prompt: 'Selecione o inquilino' }, class: 'w-full rounded border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:bg-slate-800 dark:text-slate-100' %>
          </div>
          <div>
            <%= form.label :start_date, 'Data de início', class: 'block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1' %>
            <%= form.date_field :start_date, class: 'w-full rounded border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:bg-slate-800 dark:text-slate-100' %>
          </div>
          <div>
            <%= form.label :end_date, 'Data fim', class: 'block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1' %>
            <%= form.date_field :end_date, class: 'w-full rounded border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 dark:bg-slate-800 dark:text-slate-100' %>
          </div>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
          <button type="button" data-reserve-close class="btn btn-ghost w-full sm:w-auto">Cancelar</button>
          <%= form.submit 'Confirmar reserva', class: 'btn btn-primary w-full sm:w-auto' %>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var modal = document.getElementById('reserve-modal');
      var propertyIdField = document.getElementById('reserve_property_id');
      var rentValueField = document.getElementById('reserve_rent_value');
      var propertyDetails = document.getElementById('reserve_property_details');
      document.querySelectorAll('[data-reserve-open]').forEach(function (button) {
        button.addEventListener('click', function () {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          propertyIdField.value = button.dataset.propertyId;
          rentValueField.value = button.dataset.rentValue;
          propertyDetails.textContent = button.dataset.propertyAddress;
        });
      });
      document.querySelectorAll('[data-reserve-close]').forEach(function (button) {
        button.addEventListener('click', function () {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        });
      });
    });
  </script>
</div>