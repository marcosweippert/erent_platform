<div class="bg-white p-6 rounded-lg shadow space-y-4">
  <%= form_with(model: property, local: true) do |form| %>
    <% if property.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded mb-4">
        <strong>Erros ao salvar:</strong>
        <ul class="mt-1 text-sm list-disc list-inside">
          <% property.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Seção 1: Dados do Imóvel -->
    <div class="p-2">
      <hr class="my-2 border-t border-gray-300">
      <h2 class="text-sm font-semibold text-emerald-600 mb-2 text-center tracking-wide uppercase">Dados do Imóvel</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
        <div>
          <%= form.label :property_type, "Tipo", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.select :property_type, Property.property_types.keys.map { |t| [t("activerecord.attributes.property.property_type.#{t}"), t] }, {}, 
                id: "property_property_type", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :reference, "Referência", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :reference, id: "property_reference", readonly: true, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :owner_id, "Proprietário", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.collection_select :owner_id, Person.where(person_type: :owner), :id, :name, 
                { prompt: "Selecione o proprietário" }, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :rent_value, "Valor do Aluguel", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :rent_value, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :category, "Categoria", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.select :category, Property.categories.keys.map { |t| [t("activerecord.attributes.property.category.#{t}"), t] }, {}, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :status, "Status", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.select :status, Property.statuses.keys.map { |status| [I18n.t("activerecord.attributes.property.status.#{status}", default: status.humanize), status] }, {}, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
      </div>
    </div>

    <!-- Seção 2: Endereço -->
    <div class="p-2">
      <hr class="my-2 border-t border-gray-300">
      <h2 class="text-sm font-semibold text-emerald-600 mb-2 text-center tracking-wide uppercase">Endereço</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
        <div>
          <%= form.label :zip_code, "CEP", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :zip_code, id: "property_zip_code", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :street, "Rua", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :street, id: "property_street", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :number, "Número", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :number, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :neighborhood, "Bairro", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :neighborhood, id: "property_neighborhood", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :city, "Cidade", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :city, id: "property_city", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div>
          <%= form.label :state, "Estado", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :state, id: "property_state", 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>

        <div class="md:col-span-2">
          <%= form.label :complement, "Complemento", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :complement, 
                class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
      </div>
    </div>

    <div class="pt-4 flex gap-2">
      <%= form.submit 'Salvar', id: "submit_property", 
            class: "bg-green-600 text-white text-xs px-2 py-1 rounded shadow hover:bg-green-700 transition",
            data: { disable_with: "Salvando..." } %>

      <%= link_to 'Voltar', properties_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", function () {
    const cepInput = document.querySelector("#property_zip_code");

    cepInput.addEventListener("blur", function () {
      const cep = cepInput.value.replace(/\D/g, "");
      if (cep.length !== 8) return;

      fetch(`/properties/address_lookup?cep=${cep}`)
        .then((res) => res.json())
        .then((data) => {
          if (data.error) {
            alert(data.error);
          } else {
            document.querySelector("#property_street").value = data.street || "";
            document.querySelector("#property_neighborhood").value = data.neighborhood || "";
            document.querySelector("#property_city").value = data.city || "";
            document.querySelector("#property_state").value = data.state || "";
          }
        })
        .catch((err) => console.error("Erro ao buscar endereço:", err));
    });

    // Gerar referência automática
    const tipoInput = document.querySelector("#property_property_type");
    const referenciaInput = document.querySelector("#property_reference");
    const submitButton = document.querySelector("#submit_property");

    if (tipoInput && referenciaInput && submitButton) {
      submitButton.disabled = true;

      tipoInput.addEventListener("change", function () {
        const tipo = this.value;
        referenciaInput.value = "";
        submitButton.disabled = true;
        if (!tipo) return;

        fetch(`/properties/generate_reference?property_type=${tipo}`)
          .then(res => res.json())
          .then(data => {
            referenciaInput.value = data.reference || "";
            submitButton.disabled = false;
          })
          .catch(err => {
            console.error("Erro ao gerar referência:", err);
            submitButton.disabled = false;
          });
      });

      // Se já houver um tipo selecionado ao carregar, dispara a busca de referência
      if (tipoInput && tipoInput.value && referenciaInput && referenciaInput.value === "") {
        const tipo = tipoInput.value;
        fetch(`/properties/generate_reference?property_type=${tipo}`)
          .then(res => res.json())
          .then(data => {
            referenciaInput.value = data.reference || "";
            submitButton.disabled = false;
          })
          .catch(err => {
            console.error("Erro ao gerar referência no carregamento:", err);
            submitButton.disabled = false;
          });
      }

      // Habilita o botão ao modificar qualquer campo
      const formFields = document.querySelectorAll("#property_property_type, #property_rent_value, #property_zip_code, #property_street, #property_number, #property_neighborhood, #property_city, #property_state, #property_complement, #property_category, #property_status");

      formFields.forEach(field => {
        field.addEventListener("input", () => {
          submitButton.disabled = false;
        });
      });
    }
  });
</script>