<div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-semibold text-emerald-500 flex items-center gap-2">🏘️ Imóveis</h1>
    <%= link_to 'Novo Imóvel', new_property_path, class: "btn btn-primary" %>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
    <table class="min-w-full text-sm text-left text-gray-800">
      <thead class="bg-gray-100 text-gray-700">
        <tr>
          <th class="py-3 px-4">ID</th>
          <th class="py-3 px-4">Referencia</th>
          <th class="py-3 px-4">Imóvel</th>
          <th class="py-3 px-4">Proprietário</th>
          <th class="py-3 px-4">Valor</th>
          <th class="py-3 px-4">Status</th>
          <th class="py-3 px-4">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @properties.each do |property| %>
          <tr class="border-t hover:bg-gray-50 transition duration-200">
            <td class="py-2 px-4"><%= property.id %></td>
            <td class="py-2 px-4"><%= property.reference %></td>
            <td class="py-2 px-4"><%= property.street %>, <%= property.number %>, <%= property.complement %>, <%= property.city %>, <%= property.state %></td>
            <td class="py-2 px-4"><%= property.owner.name %></td>
            <td class="py-2 px-4"><%= number_to_currency(property.rent_value, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            <td class="py-2 px-4">
              <% if property.reserved? %>
                Reservado — <%= property.reserved_tenant_name || 'sem inquilino' %>
              <% else %>
                <%= property.status.present? ? property.status.humanize : '-' %>
              <% end %>
            </td>
            <td class="py-2 px-4">
              <div class="flex gap-x-2 items-center">
                <%= link_to 'Detalhe', property_path(property), class: 'btn btn-ghost' %>
                <% if property.available? %>
                  <%= link_to 'Alugar', new_contract_path(property_id: property.id), class: 'btn btn-accent' %>
                <% end %>
                <%= button_to 'Excluir', property_path(property), method: :delete, data: { turbo_confirm: 'Tem certeza que deseja excluir esse imovel?' }, class: 'btn btn-danger' %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to 'Voltar', root_path, class: 'btn btn-ghost' %>
  </div>

</div>