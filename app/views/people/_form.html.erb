<div class="bg-white p-6 rounded-lg shadow space-y-4">
  <%= form_with(model: person, local: true) do |form| %>

    <div class="p-2">
      <hr class="my-2 border-t border-gray-300">
      <h2 class="text-sm font-semibold text-emerald-600 mb-2 text-center tracking-wide uppercase">Dados Pessoais e Endereço</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
        <div>
          <%= form.label :name, "Nome", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :cpf, "CPF", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :cpf, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :rg, "RG", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :rg, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :marital_status, "Estado Civil", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :marital_status, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :nationality, "Nacionalidade", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :nationality, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :phone, "Telefone", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.telephone_field :phone, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :email, "Email", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :zip_code, "CEP", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :zip_code, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :street, "Rua", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :street, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :number, "Número", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :number, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :neighborhood, "Bairro", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :neighborhood, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :city, "Cidade", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :city, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :state, "Estado", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :state, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :complement, "Complemento", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_field :complement, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
      </div>
    </div>

    <!-- Seção: Informações Adicionais -->
    <div class="p-2">
      <hr class="my-2 border-t border-gray-300">
      <h2 class="text-sm font-semibold text-emerald-600 mb-2 text-center tracking-wide uppercase">Informações Adicionais</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
        <div>
          <%= form.label :status, "Status", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.select :status, Person.statuses.keys.map { |s| [t("activerecord.attributes.person.status.#{s}"), s] }, {}, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div>
          <%= form.label :person_type, "Tipo", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.select :person_type, Person.person_types.keys.map { |t| [t("activerecord.attributes.person.person_type.#{t}"), t] }, {}, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :observations, "Observações", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= form.text_area :observations, rows: 4, class: "w-full text-xs py-0.5 px-1.5 border border-gray-300 rounded bg-gray-50 focus:outline-none focus:ring" %>
        </div>
      </div>
    </div>

    <div class="pt-4 flex gap-2">
      <%= form.submit 'Salvar', class: "bg-green-600 text-white text-xs px-2 py-1 rounded shadow hover:bg-green-700 transition" %>
      <%= link_to 'Voltar', people_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
<script>
  document.addEventListener("turbo:load", function () {
    const cpfInput = document.querySelector("#person_cpf");
    const cepInput = document.querySelector("#person_zip_code");

    // Máscara para CPF
    cpfInput.addEventListener("input", function (e) {
      let value = e.target.value.replace(/\D/g, "");
      value = value.replace(/(\d{3})(\d)/, "$1.$2");
      value = value.replace(/(\d{3})(\d)/, "$1.$2");
      value = value.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
      e.target.value = value;
    });

    // Auto preenchimento de endereço via CEP
    cepInput.addEventListener("blur", function () {
      const cep = cepInput.value.replace(/\D/g, "");
      if (cep.length !== 8) return;

      fetch(`/people/address_lookup?cep=${cep}`)
        .then((res) => res.json())
        .then((data) => {
          if (data.error) {
            alert(data.error);
          } else {
            document.querySelector("#person_street").value = data.street || "";
            document.querySelector("#person_neighborhood").value = data.neighborhood || "";
            document.querySelector("#person_city").value = data.city || "";
            document.querySelector("#person_state").value = data.state || "";
          }
        })
        .catch((err) => console.error("Erro ao buscar endereço:", err));
    });
  });
</script>