<div class="bg-white p-6 rounded shadow">
  <% label_class = "block text-sm font-medium text-gray-700 mb-1" %>
  <% input_class = "w-full py-1 px-2 border border-gray-300 rounded bg-gray-50 text-sm" %>
  <% select_class = "w-full py-1 px-2 border border-gray-300 rounded bg-gray-50 text-sm" %>

  <%= form_with(model: contract_amendment, local: true) do |form| %>
    <div class="space-y-8">
      <!-- Seção: Identificação do Contrato -->
      <div class="space-y-4">
        <div class="border-b border-gray-200 pb-2">
          <h2 class="text-sm font-semibold text-emerald-600 uppercase tracking-wide">Contrato Referente</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :contract_id, "Contrato", class: label_class %>
            <%= form.collection_select :contract_id, Contract.all, :id, :id, { prompt: "Selecione" }, class: select_class %>
          </div>
          <div>
            <%= form.label :amendment_contract_period, "Novo Período (meses)", class: label_class %>
            <%= form.select :amendment_contract_period, [['6 meses', 6], ['12 meses', 12], ['24 meses', 24]], { prompt: "Selecione" }, class: select_class %>
          </div>
        </div>
      </div>

      <!-- Seção: Período e Valor -->
      <div class="space-y-4">
        <div class="border-b border-gray-200 pb-2">
          <h2 class="text-sm font-semibold text-emerald-600 uppercase tracking-wide">Período e Valor</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :amendment_start_date, "Nova Data de Início", class: label_class %>
            <%= form.date_field :amendment_start_date, class: input_class %>
          </div>
          <div>
            <%= form.label :amendment_end_date, "Nova Data de Término", class: label_class %>
            <%= form.date_field :amendment_end_date, class: input_class %>
          </div>
          <div>
            <%= form.label :amendment_rent_value, "Novo Valor do Aluguel", class: label_class %>
            <%= form.number_field :amendment_rent_value, step: 0.01, class: input_class %>
          </div>
        </div>
      </div>

      <!-- Ações -->
      <div class="pt-4 flex gap-2">
        <%= form.submit 'Salvar', class: "btn btn-accent text-xs" %>
        <%= link_to 'Voltar', contract_amendments_path, class: "btn btn-ghost text-xs" %>
      </div>
    </div>
  <% end %>
</div>
