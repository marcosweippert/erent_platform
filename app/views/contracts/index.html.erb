<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-semibold text-emerald-500 flex items-center gap-2">📄 Contratos</h1>
    <%= link_to 'Novo Contrato', new_contract_path, class: 'btn btn-primary' %>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
    <table class="min-w-full text-sm text-left text-gray-800">
      <thead class="bg-gray-100 text-gray-700">
        <tr>
          <th class="py-3 px-4">ID</th>
          <th class="py-3 px-4">Imóvel</th>
          <th class="py-3 px-4">Inquilino</th>
          <th class="py-3 px-4">Valor</th>
          <th class="py-3 px-4">Início</th>
          <th class="py-3 px-4">Término</th>
          <th class="py-3 px-4">Status</th>
          <th class="py-3 px-4">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @contracts.each do |contract| %>
          <tr class="border-t hover:bg-gray-50 transition duration-200">
            <td class="py-2 px-4"><%= contract.id %></td>
            <td class="py-2 px-4"><%= contract.property.reference %> - <%= contract.property.street %>, <%= contract.property.number %>, <%= contract.property.complement %></td>
            <td class="py-2 px-4"><%= contract.tenant.name %></td>
            <td class="py-2 px-4"><%= number_to_currency(contract.rent_value, unit: "R$ ", separator: ",", delimiter: ".") %></td>
            <td class="py-2 px-4"><%= l contract.start_date, format: "%d/%m/%Y" %></td>
            <td class="py-2 px-4"><%= l contract.end_date, format: "%d/%m/%Y" %></td>
            <td class="py-2 px-4"><%= t("activerecord.attributes.contract.status.#{contract.status}") if contract.status.present? %></td>
            <td class="py-2 px-4">
              <div class="flex gap-x-2 items-center">
                <%= link_to 'Detalhes', contract_path(contract), class: 'btn btn-ghost' %>
                
                <% if contract.status == "active" %>
                  <button type="button" class="btn btn-danger" onclick="document.getElementById('modal-<%= contract.id %>').style.display = 'flex'">
                    Finalizar
                  </button>

                  <div id="modal-<%= contract.id %>" style="display: none;" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex justify-center items-center z-50">
                    <div class="bg-white p-4 rounded shadow w-80 dark:bg-slate-800">
                      <h2 class="text-lg font-bold mb-2">Finalizar Contrato</h2>
                      <%= form_with model: contract, url: finalize_contract_path(contract), method: :patch, local: true do |f| %>
                        <div class="mb-3">
                          <%= f.label :end_date, "Data de Término", class: "block text-sm text-gray-700 dark:text-slate-200" %>
                          <%= f.date_field :end_date, class: "w-full border border-gray-300 rounded px-2 py-1 text-sm" %>
                        </div>
                        <div class="flex justify-end gap-2 mt-4">
                          <%= f.submit "Confirmar", class: "btn btn-primary" %>
                          <button type="button" onclick="document.getElementById('modal-<%= contract.id %>').style.display='none'" class="text-xs text-gray-600 hover:underline">Cancelar</button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-6">
    <%= link_to 'Voltar', root_path, class: 'btn btn-ghost btn-xs' %>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("button[data-action='click->toggle#toggle']").forEach(button => {
      button.addEventListener("click", function () {
        const targetId = this.getAttribute("data-target");
        const modal = document.getElementById(targetId);
        if (modal) modal.style.display = "flex";
      });
    });
  });
</script>