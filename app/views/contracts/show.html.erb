<div class="container mx-auto px-4 py-6">
  <h1 class="text-3xl font-bold text-emerald-500 mb-4">Detalhes do Contrato</h1>

  <div class="bg-white shadow rounded p-6 space-y-8">
    <div class="border-b pb-1">
      <h2 class="text-lg font-semibold text-gray-800 mb-1">📄 Dados do Contrato</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        <p><strong>Imóvel:</strong> <%= @contract.property.reference %> - <%= @contract.property.street %> - <%= @contract.property.complement %></p>
        <p><strong>Inquilino:</strong> <%= @contract.tenant.name %></p>
        <p><strong>Proprietário:</strong> <%= @contract.owner.name %></p>
        <p><strong>Valor Aluguel:</strong> <%= number_to_currency(@contract.rent_value, unit: "R$ ", separator: ",", delimiter: ".") %></p>
        <p><strong>Período:</strong> <%= Contract.contract_periods[@contract.contract_period].presence || @contract.contract_period.to_s.humanize %> Meses</p>
        <p><strong>Início:</strong> <%= @contract.start_date.present? ? l(@contract.start_date, format: "%d/%m/%Y") : "-" %></p>
        <p><strong>Fim:</strong> <%= @contract.end_date.present? ? l(@contract.end_date, format: "%d/%m/%Y") : "-" %></p>
        <p><strong>Assinatura:</strong> <%= @contract.signature_date.present? ? l(@contract.signature_date, format: "%d/%m/%Y") : "-" %></p>
      </div>
    </div>

    <div class="border-b pb-1">
      <h2 class="text-lg font-semibold text-gray-800 mb-1">💰 Garantia</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        <p><strong>Tipo:</strong> <%= @contract.guarantee %></p>
        <p><strong>Valor Caução:</strong> <%= number_to_currency(@contract.guarantee_value, unit: "R$ ", separator: ",", delimiter: ".") %></p>
      <% if @contract.guarantee_payment_date.present? %>
        <p><strong>Data Pagamento:</strong> <%= l(@contract.guarantee_payment_date, format: "%d/%m/%Y") %></p>
      <% else %>
        <p><strong>Data Pagamento:</strong> Não informada</p>
      <% end %>
        <p><strong>Parcelas:</strong> <%= @contract.guarantee_installments.present? ? @contract.guarantee_installments : "-" %></p>
      </div>
    </div>

    <div>
      <h2 class="text-lg font-semibold text-gray-800 mb-1">📅 Pagamento</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        <p><strong>Forma:</strong> <%= @contract.payment_method&.humanize || "-" %></p>
        <p><strong>Dia pagamento:</strong> <%= @contract.payment_day.present? ? Contract.payment_days[@contract.payment_day] : "-" %></p>
        <p><strong>1º Pagamento:</strong> <%= @contract.first_payment_date.present? ? l(@contract.first_payment_date, format: "%d/%m/%Y") : "-" %></p>
        <p><strong>Valor 1ª Parcela:</strong> <%= @contract.first_payment_value.present? ? number_to_currency(@contract.first_payment_value, unit: "R$ ", separator: ",", delimiter: ".") : "-" %></p>
      </div>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-1">🧾 Histórico de Vistorias</h2>
    <% if @contract.inspections.any? %>
      <table class="min-w-full bg-white border rounded shadow text-sm">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-2 text-left">Tipo</th>
            <th class="px-4 py-2 text-left">Data</th>
            <th class="px-4 py-2 text-left">Imóvel</th>
            <th class="px-4 py-2 text-left">Status</th>
            <th class="px-4 py-2 text-left">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @contract.inspections.order(inspection_date: :desc).each do |inspection| %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-2"><%= inspection.inspection_type&.humanize || '-' %></td>
              <td class="px-4 py-2"><%= inspection.inspection_date.present? ? l(inspection.inspection_date, format: '%d/%m/%Y') : '-' %></td>
              <td class="px-4 py-2"><%= inspection.property.reference %></td>
              <td class="px-4 py-2"><%= inspection.status&.humanize || '-' %></td>
              <td class="px-4 py-2">
                <%= link_to 'Ver termo', contract_inspection_path(@contract, inspection), class: 'bg-green-600 text-white text-xs px-2 py-1 rounded hover:bg-green-700' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-600 text-sm">Nenhuma vistoria registrada para este contrato.</p>
    <% end %>
  </div>

  <div class="mt-6 flex gap-2 flex-wrap">
    <%= link_to 'Editar', edit_contract_path(@contract), class: 'btn btn-ghost' %>
    <%= link_to 'Contrato PDF', contract_pdf_contract_path(@contract, format: :pdf), class: 'btn btn-ghost', target: "_blank" %>
    <%= link_to 'Registrar vistoria', new_contract_inspection_path(@contract), class: 'btn btn-accent' %>
    <%= button_to 'Excluir', contract_path(@contract), method: :delete, data: { turbo_confirm: 'Tem certeza que deseja excluir este contrato?' }, class: 'btn btn-danger' %>
    <%= link_to 'Voltar', contracts_path, class: 'btn btn-ghost' %>
  </div>
</div>